# Server-side only. Never prefix with NEXT_PUBLIC_.
ALCHEMY_API_KEY=your_alchemy_api_key

# Required to protect /admin. Use a long random password, not a personal password.
ADMIN_PASSWORD=replace_with_a_long_random_password
# Used to sign the HttpOnly admin session cookie. Keep this different from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
